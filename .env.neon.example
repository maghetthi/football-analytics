# Copy to .env.neon (gitignored) and fill from the Neon console: Connection Details.
# Use the DIRECT connection (turn the "Connection pooling" toggle off): migrations and the
# publish step run DDL, which is safest without a transaction pooler.
# Never paste these values into chat, issues or commits.

POSTGRES_HOST=ep-xxxxxxxx.us-east-2.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_SSLMODE=require

# Password for the read-only API role created in Neon. Invent a NEW strong value: it must not
# be the one in your local .env.
API_DB_PASSWORD=

# Same connection as a URL, used only by infra/scripts/publish_marts.sh
TARGET_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
