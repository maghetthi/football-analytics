# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# --- PostgreSQL (shared by compose and the Python services) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=football_analytics
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- API ---
# Read-only role created by migration 0002 (password required to run `make migrate`).
API_DB_USER=api_reader
API_DB_PASSWORD=change-me-too
# Comma-separated keys accepted in the X-API-Key header. Empty rejects every request.
API_KEYS=
CACHE_TTL_SECONDS=3600

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- StatsBomb Open Data ---
# Git ref of statsbomb/open-data to read from. Pin a commit SHA for reproducible runs.
STATSBOMB_REF=master

# --- API-Football (week 5) ---
API_FOOTBALL_KEY=
API_FOOTBALL_DAILY_BUDGET=90
