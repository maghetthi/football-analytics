# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# --- PostgreSQL (shared by compose and the Python services) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=football_analytics
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- StatsBomb Open Data ---
# Git ref of statsbomb/open-data to read from. Pin a commit SHA for reproducible runs.
STATSBOMB_REF=master

# --- API-Football (week 5) ---
API_FOOTBALL_KEY=
API_FOOTBALL_DAILY_BUDGET=90
